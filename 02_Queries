#Q48. Disease with highest average Cholesterol
SELECT Disease,
ROUND(AVG(Cholesterol),2) AS AverageCholesterol
FROM PatientRecords
GROUP BY Disease
ORDER BY AverageCholesterol DESC
LIMIT 1;

#Q49. Disease with highest average BMI
SELECT Disease,
ROUND(AVG(BMI),2) AS AverageBMI
